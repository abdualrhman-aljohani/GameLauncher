// Panel.rc
#include <windows.h>
#include "../Common/Resource.h"
IDI_APPICON ICON "../Common/app_icon.ico"
IDR_PANEL_HTML RCDATA "panel_ui.html"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Abdualrhman Aljohani"
            VALUE "FileDescription",  "GameLauncher Control Panel"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "GameLauncher Panel"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Abdualrhman Aljohani. All Rights Reserved."
            VALUE "OriginalFilename", "Panel.exe"
            VALUE "ProductName",      "GameLauncher"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
