// Launcher.rc
#include <windows.h>
#include "../Common/Resource.h"

// HTML المُدمج للوحة التحكم (يُستخرَج في وقت التشغيل)
IDR_PANEL_HTML RCDATA "..\\Panel\\panel_ui.html"
// ✅ جديد: ملفات CSS و JS المنفصلة (panel_ui.html يستدعيها بـ <link> و <script>)
IDR_PANEL_CSS  RCDATA "..\\Panel\\panel_ui.css"
IDR_PANEL_JS   RCDATA "..\\Panel\\panel_ui.js"
IDI_APPICON ICON "../Common/app_icon.ico"

// ✅ معلومات النسخة/حقوق النشر — تظهر في خصائص GameLauncher.exe (تبويب Details)
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,8,0,0
 PRODUCTVERSION 1,8,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Abdualrhman Aljohani"
            VALUE "FileDescription",  "GameLauncher - Radial Game Launcher"
            VALUE "FileVersion",      "1.8.0.0"
            VALUE "InternalName",     "GameLauncher"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Abdualrhman Aljohani. Licensed under PolyForm Noncommercial 1.0.0."
            VALUE "OriginalFilename", "GameLauncher.exe"
            VALUE "ProductName",      "GameLauncher"
            VALUE "ProductVersion",   "1.8.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END